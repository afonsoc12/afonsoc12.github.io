---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import TerminalHero from "../components/TerminalHero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import packageJson from "../../package.json";
import profileImage from "../assets/images/profile.png";

const version = packageJson.version;
const commitSha = __COMMIT_SHA__;
const versionLabel = import.meta.env.DEV
  ? `v${version}+dev`
  : commitSha !== "unknown"
    ? `v${version}+${commitSha}`
    : `v${version}`;
---

<Base title="Afonso Costa" description="Afonso Costa's Personal Website">
  <Sidebar />

  <!-- Flex column wrapper: header sits outside the snap scroll container -->
  <div id="app-shell" class="fixed inset-0 flex flex-col lg:left-72">
    <!-- Mobile header — only visible below lg -->
    <header
      class="z-50 flex-shrink-0 border-b border-slate-800/90 bg-slate-950/95 backdrop-blur-sm lg:hidden"
    >
      <div class="flex items-center px-6 py-4">
        <button
          id="mobile-menu-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="mr-3 -ml-1 p-1 text-slate-400 transition-colors hover:text-white"
        >
          <svg
            id="hamburger-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        <span class="text-sm font-semibold text-white">Afonso Costa</span>
      </div>
      <!-- Collapsible panel — mirrors sidebar content -->
      <div
        id="mobile-nav"
        class="hidden border-t border-slate-800/90 px-6 py-5"
      >
        <div class="mb-4 flex items-center gap-4">
          <a
            href="/"
            class="mobile-nav-link h-14 w-14 flex-shrink-0 overflow-hidden rounded-full border-2 border-cyan-800/50 bg-slate-800"
          >
            <img
              src={profileImage.src}
              alt="Afonso Costa"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </a>
          <div>
            <p class="text-sm font-semibold text-white">Afonso Costa</p>
            <p class="text-xs text-cyan-300">
              Sr. Data Platform Engineer, MSc.
            </p>
          </div>
        </div>
        <div class="mb-5 flex gap-5">
          <a
            href="https://github.com/afonsoc12"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-xs font-medium text-slate-400 transition-colors hover:text-cyan-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path>
            </svg>
            GitHub
          </a>
          <a
            href="https://linkedin.com/in/afonsoc12"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-xs font-medium text-slate-400 transition-colors hover:text-cyan-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            LinkedIn
          </a>
        </div>
        <nav class="flex flex-col gap-1 border-t border-slate-800/90 pt-4">
          <a
            href="#hero"
            class="mobile-nav-link rounded-md px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-800/80 hover:text-white"
            >Home</a
          >
          <a
            href="#about"
            class="mobile-nav-link rounded-md px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-800/80 hover:text-white"
            >About</a
          >
          <a
            href="#experience"
            class="mobile-nav-link rounded-md px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-800/80 hover:text-white"
            >Experience</a
          >
          <a
            href="#projects"
            class="mobile-nav-link rounded-md px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-800/80 hover:text-white"
            >Projects</a
          >
          <a
            href="#contact"
            class="mobile-nav-link rounded-md px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-800/80 hover:text-white"
            >Contact</a
          >
        </nav>
        <a
          href={`https://github.com/afonsoc12/afonsoc12.github.io/releases/tag/v${version}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 font-mono text-[11px] tracking-wide text-slate-500 transition-colors hover:text-cyan-300"
        >
          {versionLabel}
        </a>
      </div>
    </header>

    <script>
      const toggle = document.getElementById("mobile-menu-toggle");
      const nav = document.getElementById("mobile-nav");
      const hamburgerIcon = document.getElementById("hamburger-icon");
      const closeIcon = document.getElementById("close-icon");

      function closeNav() {
        if (nav?.classList.contains("hidden")) return;
        nav?.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
      }

      toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !nav?.classList.contains("hidden");
        if (isOpen) {
          closeNav();
        } else {
          nav?.classList.remove("hidden");
          hamburgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
          toggle.setAttribute("aria-expanded", "true");
        }
      });

      document.addEventListener("click", (e) => {
        if (
          !nav?.classList.contains("hidden") &&
          !nav?.contains(e.target as Node)
        ) {
          closeNav();
        }
      });

      // Close nav when a link is clicked (anchor navigation)
      document.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", closeNav);
      });
    </script>

    <main
      id="main-scroll"
      class="min-h-0 flex-1 snap-y snap-mandatory overflow-y-auto overscroll-y-contain"
    >
      <TerminalHero />

      <About />
      <Experience />
      <Projects />
      <Contact />
    </main>

    <!-- Progress dots + scroll cue (single aligned container) -->
    <div
      id="nav-cue-wrapper"
      class="fixed -right-1 bottom-8 z-50 flex flex-col items-center opacity-0 transition-opacity duration-500 lg:right-8"
      aria-hidden="true"
    >
      <!-- Dots -->
      <div id="section-dots" class="flex flex-col items-center gap-1.5">
        {
          ["hero", "about", "experience", "projects", "contact"].map((id) => (
            <span
              data-dot={id}
              class="block h-1.5 w-1.5 rounded-full bg-gray-600 transition-colors duration-300"
            />
          ))
        }
      </div>

      <!-- Scroll down arrow -->
      <div
        id="global-scroll-cue"
        class="pointer-events-none mt-4 flex flex-col items-center"
      >
        <svg
          class="h-5 w-5 animate-bounce text-gray-500"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 6l-7 7-7-7"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 13l-7 7-7-7"></path>
        </svg>
      </div>

      <!-- Back to top button -->
      <button
        id="back-to-top"
        class="pointer-events-none mt-0.5 flex flex-col items-center gap-0.5 px-2.5 py-2 opacity-0 transition-all duration-500 active:scale-95"
        aria-label="Scroll back to top"
      >
        <svg
          class="h-5 w-5 animate-bounce text-white/60 transition-colors group-hover:text-white/90"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 18l7-7 7 7"
          ></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7"
          ></path>
        </svg>
        <span class="text-xs text-white/50">top</span>
      </button>
    </div>
  </div>

  <script>
    // iOS Safari: the visual viewport shifts upward when the keyboard opens,
    // even on position:fixed elements. Repin the shell to the visual viewport.
    const shell = document.getElementById("app-shell") as HTMLElement | null;
    function pinToVisualViewport() {
      const vv = window.visualViewport;
      if (!vv || !shell) return;
      shell.style.top = `${vv.offsetTop}px`;
      shell.style.height = `${vv.height}px`;
    }
    if (window.visualViewport) {
      window.visualViewport.addEventListener("resize", pinToVisualViewport);
      window.visualViewport.addEventListener("scroll", pinToVisualViewport);
    }

    // Scroll navigation cue logic
    const navWrapper = document.getElementById(
      "nav-cue-wrapper",
    ) as HTMLElement;
    const scrollCue = document.getElementById(
      "global-scroll-cue",
    ) as HTMLElement;
    const backToTop = document.getElementById("back-to-top") as HTMLElement;
    const dotsContainer = document.getElementById(
      "section-dots",
    ) as HTMLElement;
    const mainEl = document.getElementById("main-scroll") as HTMLElement;
    const sections = ["hero", "about", "experience", "projects", "contact"];

    function showCue(visible: boolean) {
      scrollCue.style.opacity = visible ? "1" : "0";
      scrollCue.style.pointerEvents = "none";
    }

    function showBackToTop(visible: boolean) {
      backToTop.style.opacity = visible ? "1" : "0";
      backToTop.style.pointerEvents = visible ? "auto" : "none";
    }

    function updateDots(activeId: string) {
      // Show wrapper on all sections except hero
      const visible = activeId !== "hero";
      navWrapper.style.opacity = visible ? "1" : "0";
      dotsContainer.querySelectorAll("[data-dot]").forEach((dot) => {
        const el = dot as HTMLElement;
        if (el.dataset.dot === activeId) {
          el.classList.remove("bg-gray-600");
          el.classList.add("bg-gray-400");
        } else {
          el.classList.remove("bg-gray-400");
          el.classList.add("bg-gray-600");
        }
      });
    }

    const sectionEls = sections.map((id) => document.getElementById(id));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          showCue(id !== "hero" && id !== "contact");
          showBackToTop(id === "contact");
          updateDots(id);
        }
      },
      { root: mainEl, threshold: 0.5 },
    );

    sectionEls.forEach((el) => el && observer.observe(el));

    backToTop.addEventListener("click", () => {
      const hero = document.getElementById("hero");
      hero?.scrollIntoView({ behavior: "smooth" });
    });
  </script>
</Base>

---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Portfolio", description = "Personal website" } = Astro.props;

import "../styles/global.css";
import profileImage from "../assets/images/profile.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={profileImage.src} />
    <link rel="apple-touch-icon" href={profileImage.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QKE8QXW8T8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: unknown[]){dataLayer.push(args);}
      gtag('js', new Date());
      gtag('config', 'G-QKE8QXW8T8');
    </script>
  </head>
  <body class="bg-gray-950 text-gray-100 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #080b12;
    --bg-soft: #111827;
    --text: #e5e7eb;
    --muted: #94a3b8;
    --line: #1f2937;
    --accent: #22d3ee;
    --accent-2: #f59e0b;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    background:
      radial-gradient(
        1200px 700px at 100% -20%,
        rgba(34, 211, 238, 0.18),
        transparent 55%
      ),
      radial-gradient(
        900px 500px at -20% 40%,
        rgba(245, 158, 11, 0.12),
        transparent 55%
      ),
      var(--bg);
    color: var(--text);
  }

  .font-mono,
  code,
  pre {
    font-family: "IBM Plex Mono", monospace;
  }

  .section-shell {
    max-width: 52rem;
    margin-inline: auto;
    padding: 5.5rem 1.5rem;
  }

  @media (max-width: 640px) {
    .section-shell {
      padding-inline: 1.9rem;
    }
  }

  .eyebrow {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.1;
    font-weight: 700;
    margin-bottom: 0.9rem;
  }

  .section-intro {
    color: var(--muted);
    line-height: 1.75;
    max-width: none;
  }

  .glass-card {
    background: linear-gradient(
      145deg,
      rgba(17, 24, 39, 0.78),
      rgba(2, 6, 23, 0.8)
    );
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    backdrop-filter: blur(8px);
  }

  .fade-up {
    animation: fadeUp 0.7s ease both;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

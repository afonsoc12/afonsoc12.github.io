<section
  id="hero"
  class="flex h-full snap-start flex-col overflow-hidden bg-gray-950 font-mono"
>
  <div
    class="flex flex-shrink-0 items-center gap-2 rounded-t-lg border-b border-gray-800 bg-gray-900 px-4 py-3"
  >
    <span class="h-3 w-3 rounded-full bg-red-500"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
    <span class="h-3 w-3 rounded-full bg-green-500"></span>
    <span id="titlebar-host" class="ml-4 text-xs text-gray-500"></span>
  </div>
  <!-- Output area -->
  <div
    id="terminal-output"
    class="flex-1 overflow-y-auto px-6 py-4 text-base leading-relaxed text-green-400"
  >
  </div>
  <!-- Input row -->
  <div
    id="terminal-input-row"
    class="flex flex-shrink-0 items-center border-t border-gray-800 bg-gray-950 px-6 py-5"
  >
    <span
      id="prompt-host"
      class="mr-2 text-sm whitespace-nowrap text-indigo-400"></span>
    <input
      id="terminal-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      class="min-w-0 flex-1 bg-transparent text-base text-green-400 caret-green-400 outline-none"
      aria-label="Terminal input"
    />
  </div>
</section>

<script>
  const ABOUT_OUTPUT = `<span class="text-white">Afonso Costa</span> — Portuguese <span class="text-indigo-400">Data Engineer</span> based in Bristol, UK.<br>I build and operate data infrastructure for a crypto payments company, focused on streaming pipelines and reliable analytics workflows.<br><br>I've worked across telecoms, healthcare, research, and digital marketing, and currently in crypto.`;
  const HELP_OUTPUT = `Available commands:<br><span class="text-yellow-400">home</span> — intro section<br><span class="text-yellow-400">experience</span> — experience section<br><span class="text-yellow-400">projects</span> — projects section<br><span class="text-yellow-400">contact</span> — contact section<br><span class="text-yellow-400">skills</span> — technical skills<br><span class="text-yellow-400">whoami</span> — alias for home<br><span class="text-yellow-400">open [github|linkedin]</span> — open profile in new tab<br><span class="text-yellow-400">clear</span> — clear terminal`;

  const COMMANDS: Record<string, () => string> = {
    home: () => ABOUT_OUTPUT,
    skills: () =>
      `<span class="text-indigo-400">Languages:</span> Python, SQL, Shell<br><span class="text-indigo-400">Data:</span> Apache Kafka, dbt, Airflow, Snowflake, BigQuery<br><span class="text-indigo-400">Infra:</span> Kubernetes (CKAD), Terraform, GCP, Docker<br><span class="text-indigo-400">Databases:</span> PostgreSQL, InfluxDB, Redis`,
    experience: () =>
      `<span class="text-indigo-400">Senior Data Platform Engineer</span> · MoonPay <span class="text-gray-500">(Jan 2026 — Present)</span><br>Data platform for global crypto payments — CDC, Kafka, dbt, BigQuery on GCP.<br><br><span class="text-indigo-400">Senior Data Engineer</span> · giffgaff <span class="text-gray-500">(Jan 2022 — Jan 2026)</span><br>Built petabyte-scale AWS pipelines from Kafka and batch feeds into Snowflake, with Data Vault 2.0, dbt, GDPR-compliant microservices, and Argo on Kubernetes.<br><br><span class="text-indigo-400">Clinical Database Manager</span> · University of Bristol / UK Kidney Association <span class="text-gray-500">(Jan 2021 — Jan 2022)</span><br>Managed tranSMART operations and NURTuRE data processes for secure clinical research analytics.<br><br><span class="text-indigo-400">Researcher</span> · University of Porto and Bosch Security Systems <span class="text-gray-500">(Jul 2020 — Dec 2020)</span><br>Project Safe Cities — anomaly detection in time-series data.`,
    projects: () =>
      `<span class="text-indigo-400">Firefly CLI</span> <span class="text-gray-500">[Python, CLI, PyPI]</span> ★43<br>Command line interface for Firefly III personal finance manager.<br><br><span class="text-indigo-400">Homelab</span> <span class="text-gray-500">[IaC, Self-hosted, Automation]</span><br>Infrastructure-as-code and service automation for a personal self-hosted environment.<br><br><span class="text-indigo-400">Ready, Set, Develop</span> <span class="text-gray-500">[Ansible, Shell, macOS]</span><br>Reproducible workstation bootstrap with Ansible.<br><br><span class="text-indigo-400">Octo Usage</span> <span class="text-gray-500">[Python, PostgreSQL, REST]</span><br>Octopus Energy consumption tracker.`,
    contact: () =>
      `<span class="text-indigo-400">GitHub:</span> github.com/afonsoc12<br><span class="text-indigo-400">LinkedIn:</span> linkedin.com/in/afonsoc12`,
    help: () => HELP_OUTPUT,
    hi: () => `Hello there! 👋<br><br>${HELP_OUTPUT}`,
    hello: () => `Hello there! 👋<br><br>${HELP_OUTPUT}`,
  };

  const ALIASES: Record<string, string> = {
    whoami: "home",
  };

  const OPEN_URLS: Record<string, string> = {
    github: "https://github.com/afonsoc12",
    linkedin: "https://linkedin.com/in/afonsoc12",
  };

  const output = document.getElementById("terminal-output") as HTMLDivElement;
  const input = document.getElementById("terminal-input") as HTMLInputElement;
  const terminal = document.getElementById("hero") as HTMLElement;

  // Set hostname from current domain
  const host = window.location.hostname;
  document.getElementById("titlebar-host")!.textContent = `acosta@${host} ~ `;
  document.getElementById("prompt-host")!.textContent = `acosta@${host} ~ $ `;

  function appendOutput(html: string): void {
    const div = document.createElement("div");
    div.innerHTML = html;
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  function appendLine(text: string, cssClass?: string): void {
    const div = document.createElement("div");
    if (cssClass) div.className = cssClass;
    div.textContent = text;
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  // Typewriter greeting
  const greeting = "Welcome. Type 'help' to see available commands.";
  let charIndex = 0;

  function typeGreeting(): void {
    if (charIndex < greeting.length) {
      const greetingDiv = output.querySelector(
        "[data-greeting]",
      ) as HTMLDivElement | null;
      if (greetingDiv) {
        greetingDiv.textContent += greeting[charIndex];
      }
      charIndex++;
      setTimeout(typeGreeting, 40);
    } else {
      input.focus();
    }
  }

  // Create greeting element and start typewriter
  const greetingEl = document.createElement("div");
  greetingEl.setAttribute("data-greeting", "");
  greetingEl.className = "text-green-400";
  output.appendChild(greetingEl);
  typeGreeting();

  // Keydown handler
  input.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Enter") {
      const rawCmd = input.value.trim();
      const cmd = rawCmd.toLowerCase();
      const normalizedCmd = ALIASES[cmd] ?? cmd;
      input.value = "";

      if (!rawCmd) return;

      // Echo the command
      appendLine(`$ ${rawCmd}`, "text-gray-500");

      if (cmd.startsWith("open ")) {
        const target = cmd.slice(5).trim().toLowerCase();
        if (OPEN_URLS[target]) {
          window.open(OPEN_URLS[target], "_blank");
          appendLine(`Opening ${target}...`, "text-green-400");
        } else {
          appendLine(
            `open: unknown target '${target}'. Try: github, linkedin`,
            "text-red-400",
          );
        }
      } else if (cmd === "clear") {
        output.innerHTML = "";
      } else if (COMMANDS[normalizedCmd]) {
        appendOutput(COMMANDS[normalizedCmd]());
      } else {
        appendLine(
          `command not found: ${rawCmd}. Type 'help' for available commands.`,
          "text-red-400",
        );
      }
    } else if (e.key === "Tab") {
      e.preventDefault();
      const partial = input.value.toLowerCase();
      if (!partial) return;

      const commandKeys = [...Object.keys(COMMANDS), ...Object.keys(ALIASES)];
      // Also include 'open' as a completable prefix
      const allKeys = [...commandKeys, "open"];
      const matches = allKeys.filter((k) => k.startsWith(partial));

      if (matches.length === 1) {
        input.value = matches[0];
      } else if (matches.length > 1) {
        appendLine(`$ ${input.value}`, "text-gray-500");
        appendLine(matches.join("  "), "text-gray-400");
      }
    }
  });

  // Click anywhere in terminal to focus input
  terminal.addEventListener("click", () => {
    input.focus();
  });

  // Blur input and unfix row when hero scrolls out of view
  const scrollContainer = document.querySelector("main");
  const observer = new IntersectionObserver(
    (entries) => {
      if (!entries[0].isIntersecting) {
        input.blur();
      }
    },
    { root: scrollContainer, threshold: 0.1 },
  );
  observer.observe(terminal);
</script>

---
interface Project {
  title: string;
  description: string;
  tags: string[];
  github: string;
  demo?: string;
}

const projects: Project[] = [
  {
    title: "Firefly CLI",
    description:
      "A Python-based command line interface for conveniently entering expenses in Firefly III.",
    tags: ["Python", "CLI", "FireflyIII", "Personal Finance"],
    github: "https://github.com/afonsoc12/firefly-cli",
  },
  {
    title: "homelab",
    description: "GitOps-driven homelab. Self-hosted. Automated. Encrypted.",
    tags: ["Kubernetes", "Ansible", "Terraform", "homelab", "ArgoCD"],
    github: "https://github.com/afonsoc12/homelab",
    demo: "https://afonsocosta.dev/homelab/",
  },
  {
    title: "Ready, Set, Develop™",
    description:
      "An opinionated, reproducible workstation bootstrap system built with Ansible. Automates macOS developer environment setup including dotfiles, tooling, and configurations.",
    tags: ["Ansible", "macOS", "dotfiles", "Automation"],
    github: "https://github.com/afonsoc12/ready-set-develop",
  },
  {
    title: "OctoTrack",
    description:
      "Electricity consumption, Agile tariff rates & cost dashboard for Octopus Energy customers.",
    tags: ["Python", "Streamlit", "Docker", "Octopus Energy"],
    github: "https://github.com/afonsoc12/octo-track",
  },
];
---

<section id="projects" class="section-shell fade-up z-0 min-h-full snap-start">
  <p class="eyebrow">Build</p>
  <h2 class="section-title">Projects</h2>
  <p class="section-intro mb-10 max-w-none">
    A few things I build on my spare time, mostly around tooling, observability,
    and self-hosted services.
  </p>
  <div class="grid gap-6">
    {
      projects.map((p) => (
        <article class="glass-card p-6 transition-all duration-300 hover:-translate-y-1">
          <h3 class="mb-2 text-lg font-semibold text-white">{p.title}</h3>
          <p class="mb-4 text-sm leading-relaxed text-slate-300">
            {p.description}
          </p>
          <div class="mb-4 flex flex-wrap gap-2">
            {p.tags.map((tag) => (
              <span class="rounded-full border border-cyan-700/50 bg-cyan-900/40 px-2.5 py-1 text-xs font-medium text-cyan-200">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-4 text-sm">
            <a
              href={p.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 font-medium text-cyan-300 transition-colors hover:text-cyan-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
              GitHub
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="-ml-0.5 inline-block"
              >
                <>
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </>
              </svg>
            </a>
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 font-medium text-cyan-300 transition-colors hover:text-cyan-200"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 2v8l3-3 3 3V2" />
                  <path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20" />
                  <path d="M20 22V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15A2.5 2.5 0 0 0 6.5 22H20z" />
                </svg>
                Docs
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="-ml-0.5 inline-block"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

---
interface Project {
  title: string;
  description: string;
  tags: string[];
  github: string;
  demo?: string;
}

const projects: Project[] = [
  {
    title: "Firefly CLI",
    description:
      "A Python-based command line interface for conveniently entering expenses in Firefly III, the self-hosted personal finance manager. Published on PyPI with an interactive shell powered by cmd2.",
    tags: ["Python", "CLI", "PyPI", "Self-hosted"],
    github: "https://github.com/afonsoc12/firefly-cli",
  },
  {
    title: "Homelab",
    description:
      "Infrastructure-as-code and self-hosting setup for my personal homelab, covering services, networking, and operational automation.",
    tags: ["Homelab", "IaC", "Self-hosted", "Automation"],
    github: "https://github.com/afonsoc12/homelab",
  },
  {
    title: "Ready, Set, Develop",
    description:
      "An opinionated, reproducible workstation bootstrap system built with Ansible. Automates macOS developer environment setup including dotfiles, tooling, and configurations.",
    tags: ["Ansible", "Shell", "macOS", "Automation"],
    github: "https://github.com/afonsoc12/ready-set-develop",
  },
  {
    title: "Octo Usage",
    description:
      "Fetches electricity consumption data from the Octopus Energy API and persists it to a PostgreSQL database. Designed to run as a cronjob for continuous energy usage tracking.",
    tags: ["Python", "PostgreSQL", "REST", "Cronjob"],
    github: "https://github.com/afonsoc12/octo-usage",
  },
];
---

<section
  id="projects"
  class="section-shell fade-up h-full snap-start overflow-y-auto"
>
  <p class="eyebrow">Build</p>
  <h2 class="section-title">Projects</h2>
  <p class="section-intro mb-10 max-w-none">
    A few things I build on my spare time, mostly around tooling, observability,
    and self-hosted services.
  </p>
  <div class="grid gap-6">
    {
      projects.map((p) => (
        <article class="glass-card p-6 transition-all duration-300 hover:-translate-y-1">
          <h3 class="mb-2 text-lg font-semibold text-white">{p.title}</h3>
          <p class="mb-4 text-sm leading-relaxed text-slate-300">
            {p.description}
          </p>
          <div class="mb-4 flex flex-wrap gap-2">
            {p.tags.map((tag) => (
              <span class="rounded-full border border-cyan-700/50 bg-cyan-900/40 px-2.5 py-1 text-xs font-medium text-cyan-200">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-4 text-sm">
            <a
              href={p.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 font-medium text-cyan-300 transition-colors hover:text-cyan-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
              GitHub<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="-ml-0.5 inline-block"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </a>
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-cyan-300 transition-colors hover:text-cyan-200"
              >
                Demo<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="-ml-0.5 inline-block"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

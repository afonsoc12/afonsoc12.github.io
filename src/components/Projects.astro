---
interface Project {
  title: string;
  description: string;
  tags: string[];
  github: string;
  demo?: string;
}

const projects: Project[] = [
  {
    title: "Firefly CLI",
    description:
      "A Python-based command line interface for conveniently entering expenses in Firefly III, the self-hosted personal finance manager. Published on PyPI with an interactive shell powered by cmd2.",
    tags: ["Python", "CLI", "PyPI", "Self-hosted"],
    github: "https://github.com/afonsoc12/firefly-cli",
  },
  {
    title: "Homelab",
    description:
      "Infrastructure-as-code and self-hosting setup for my personal homelab, covering services, networking, and operational automation.",
    tags: ["Homelab", "IaC", "Self-hosted", "Automation"],
    github: "https://github.com/afonsoc12/homelab",
  },
  {
    title: "Ready, Set, Develop",
    description:
      "An opinionated, reproducible workstation bootstrap system built with Ansible. Automates macOS developer environment setup including dotfiles, tooling, and configurations.",
    tags: ["Ansible", "Shell", "macOS", "Automation"],
    github: "https://github.com/afonsoc12/ready-set-develop",
  },
  {
    title: "Octo Usage",
    description:
      "Fetches electricity consumption data from the Octopus Energy API and persists it to a PostgreSQL database. Designed to run as a cronjob for continuous energy usage tracking.",
    tags: ["Python", "PostgreSQL", "REST", "Cronjob"],
    github: "https://github.com/afonsoc12/octo-usage",
  },
];
---

<section id="projects" class="section-shell fade-up snap-start snap-always lg:min-h-screen">
  <p class="eyebrow">Build</p>
  <h2 class="section-title">Projects</h2>
  <p class="section-intro mb-10 max-w-none">A few things I build on my spare time, mostly around tooling, observability, and self-hosted services.</p>
  <div class="grid gap-6">
    {
      projects.map((p) => (
        <article class="glass-card p-6 hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-semibold text-white text-lg mb-2">{p.title}</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">{p.description}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {p.tags.map((tag) => (
              <span class="text-xs bg-cyan-900/40 text-cyan-200 border border-cyan-700/50 px-2.5 py-1 rounded-full font-medium">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-4 text-sm">
            <a
              href={p.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyan-300 hover:text-cyan-200 transition-colors font-medium"
            >
              GitHub ↗
            </a>
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyan-300 hover:text-cyan-200 transition-colors font-medium"
              >
                Demo ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
